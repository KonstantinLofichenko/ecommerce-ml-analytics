# Independent e-commerce development configuration.
# Keep actual secrets in ignored .env; .env.example contains placeholders only.
# Browser URLs use 127.0.0.1 and host ports; containers use Compose service DNS.

# ClickHouse — analytics database (also used by dbt and Python ML)
CLICKHOUSE_USER=ecommerce_app
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000

# PostgreSQL — metadata server administrator (not an application login)
POSTGRES_USER=ecommerce_metadata_admin
POSTGRES_PASSWORD=

# Metabase — PostgreSQL application metadata and local web UI
# These are database credentials. Create the Metabase UI admin/email in its setup wizard.
METABASE_DB_USER=ecommerce_metabase
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_KEY=
METABASE_PORT=13000
# Optional existing UI account for dashboard provisioning (not database credentials).
# Setting these values does not create an account or reset its password.
METABASE_URL=http://127.0.0.1:13000
METABASE_ADMIN=
METABASE_ADMIN_PWD=



# ClickHouse ingestion — staging, validation and atomic publication
CLICKHOUSE_INGEST_USER=ecommerce_ingest
CLICKHOUSE_INGEST_PASSWORD=
# ClickHouse dbt — reads raw data; writes only ecommerce_analytics
CLICKHOUSE_DBT_USER=ecommerce_dbt
CLICKHOUSE_DBT_PASSWORD=
# ClickHouse BI — read-only raw data; switch the Metabase connection manually
CLICKHOUSE_BI_USER=ecommerce_bi
CLICKHOUSE_BI_PASSWORD=
